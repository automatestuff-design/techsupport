# ── Anthropic ─────────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...

# ── Supabase ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (from Supabase Project Settings > Database > URI)
DATABASE_URL=postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres

# JWT secret for verifying Supabase Auth tokens (Project Settings > API > JWT Secret)
SUPABASE_JWT_SECRET=your-jwt-secret

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins in production
ALLOWED_ORIGINS=https://your-app.vercel.app

# ── RingCentral (optional) ────────────────────────────────────────────────────
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT_TOKEN=
# RC_WEBHOOK_URL=https://your-backend.onrender.com/api/ringcentral/ai-callback

# Copy to .env and fill in your values
ANTHROPIC_API_KEY=sk-ant-...

# RingCentral integration (optional — only needed for call sync)
# Create a JWT app at https://developers.ringcentral.com
RC_CLIENT_ID=
RC_CLIENT_SECRET=
RC_JWT_TOKEN=

# Optional: public URL of this server for AI job callbacks (faster than polling)
# RC_WEBHOOK_URL=https://your-domain.com/api/ringcentral/ai-callback
